#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#include <dt-bindings/zmk/pointing.h>

/ {


    // behaviors {
    //     right1: right1 {
    //         compatible = "zmk,behavior-hold-tap";
    //         #binding-cells = <0>;
    //
    //         flavor = "balanced";
    //         tapping-term-ms = <200>;
    //
    //         bindings = <&mo 1>, <&kp BSPC>;
    //     };
    //
    // };



    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  CAPS |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | ENTER |
// |  ESC  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | LOWER| SPACE|  ALT |                   | BSPC | SPACE | ENTER |
            bindings = <
&kp CAPS   &kp N1 &kp N2 &kp N3 &kp N4    &kp N5                &kp N6     &kp N7    &kp N8    &kp N9  &kp N0   &kp BSPC
&kp TAB    &kp Q  &kp W  &kp E  &kp R     &kp T                 &kp Y      &kp U     &kp I     &kp O   &kp P    &kp ENTER
&kp ESC    &kp A  &kp S  &kp D  &kp F     &kp G                 &kp H      &kp J     &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V     &kp B                 &kp N      &kp M     &kp COMMA &kp DOT &kp FSLH &kp RSHFT
           &sk LSHFT  &mt LCTRL ESC       &mt LMETA TAB         &lt 1 BSPC &kp SPACE &mt RCTRL ENTER
            >;
        };

        second {
// ------------------------------------------------------------------------------------------------------------
// |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |   F8  |  F9  |  F10  |  F11  |  F12  |
// |  TAB  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | ENTER |
// |   `   |  |  |  &  |  !   |  (   |  {   |                   |  }   |  )    |  -    |  +   |   *   |   '   |
// | SHIFT |  ^  |  $  |  %   |  #   |  [   |                   |  ]   |  \    |  ,    |  .   |   /   | SHIFT |
//                     |  ~   |  =   |  _   |                   |      |       |       |
            bindings = <
&kp F1    &kp F2    &kp F3   &kp F4    &kp F5    &kp F6         &kp F7   &kp F8    &kp F9   &kp F10  &kp F11  &kp F12
&kp TAB   &kp N1    &kp N2   &kp N3    &kp N4    &kp N5         &kp N6   &kp N7   &kp N8    &kp N9   &kp N0   &kp ENTER
&kp GRAVE &kp PIPE  &kp AMPS &kp EXCL  &kp LPAR  &kp LBRC       &kp RBRC &kp RPAR &kp MINUS &kp PLUS &kp STAR &kp SQT
&kp LSHFT &kp CARET &kp DLLR &kp PRCNT &kp HASH  &kp LBKT       &kp RBKT &kp BSLH &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                             &kp TILDE &kp EQUAL &kp UNDER      &none    &none    &none 
            >;
        };

        system {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |       |                   |      |       |       |       |      |     |
// |       |     |     |      |      |  NEXT |                   | MUTE |  P_UP | M_BAC | M_FOR | P_DN |     |
// |       |     |     |      | B_UP |  PLAY |                   | V_UP |  UP   |  LEFT | RIGHT | DOWN |     |
// |       |     |     |      | B_DN |  PREV |                   | V_DN |  HOME |  C-L  |  C-R  | END  |     |
//                     |      | DEL  |       |                   |      |       |       |
            bindings = <
&none &none &none &none &none        &none                       &none        &none     &none        &none         &none     &none
&none &none &none &none &none        &kp C_NEXT                  &kp C_MUTE   &kp PG_UP &mkp MB4     &mkp MB5      &kp PG_DN &none
&none &none &none &none &kp C_BRI_UP &kp C_PLAY                  &kp C_VOL_UP &kp UP    &kp LEFT     &kp RIGHT     &kp DOWN  &none
&none &none &none &none &kp C_BRI_DN &kp C_PREV                  &kp C_VOL_DN &kp HOME  &kp LC(LEFT) &kp LC(RIGHT) &kp END   &none
                  &none &kp DEL      &none                       &none        &none     &none
            >;
        };





//         lower_layer {
// // ------------------------------------------------------------------------------------------------------------
// // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
// // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// // |      |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
// // |STUDIO | EPON| EPOF| EPTOG|      |      |                   |  -   |  +    |  {   |   }  |  "|"  |       |
// //                     |      |      |      |                   |      |       |       |
//             bindings = <
// &bt BT_CLR      &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4    &trans    &trans   &trans    &trans   &trans   &trans
// &kp F1          &kp F2           &kp F3            &kp F4            &kp F5       &kp F6          &kp F7    &kp F8   &kp F9    &kp F10  &kp F11  &kp F12
// &kp GRAVE       &kp EXCL         &kp AT            &kp HASH          &kp DOLLAR   &kp PRCNT       &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp TILDE
// &studio_unlock  &ext_power EP_ON &ext_power EP_OFF &ext_power EP_TOG &trans       &trans          &kp MINUS &kp PLUS &kp LBRC  &kp RBRC &kp PIPE &trans
//                                                    &trans            &trans       &trans          &trans    &trans   &trans
//             >;
//         };
//
//         raise_layer {
// // ------------------------------------------------------------------------------------------------------------
// // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// // |      |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
// // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
// // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |                   |  +   |   -   |   =   |  [   |   ]   |   \   |
// //                     |      |      |      |                   |      |       |       |
//             bindings = <
// &trans    &trans &trans &trans  &trans  &trans      &trans   &trans    &trans    &trans   &trans   &trans
// &kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5      &kp N6   &kp N7    &kp N8    &kp N9   &kp N0   &trans
// &kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6      &trans   &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &trans
// &kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12     &kp KP_PLUS &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
//                         &trans  &trans  &trans      &trans   &trans    &trans
//             >;
//         };
//
//         extra_layer_1 {
//             bindings = <
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
//                      &trans &trans &trans   &trans &trans &trans
//             >;
//         };
//
//         extra_layer_2 {
//             bindings = <
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
//                      &trans &trans &trans   &trans &trans &trans
//             >;
//         };
//
//         extra_layer_3 {
//             bindings = <
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
// &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
//                      &trans &trans &trans   &trans &trans &trans
//             >;
//         };
    };
};
